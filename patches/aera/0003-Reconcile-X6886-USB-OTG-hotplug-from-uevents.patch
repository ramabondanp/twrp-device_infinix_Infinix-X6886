+	bool force_resync = false;
+	struct pollfd pfd = uevent_pfd;
+	pfd.revents = 0;
+	const int ready = poll(&pfd, 1, 0);
+	if (ready < 0) {
+		if (errno != EINTR) force_resync = true;
+	} else if (ready > 0 && (pfd.revents & (POLLERR | POLLHUP | POLLNVAL))) {
+		force_resync = true;
 	}
