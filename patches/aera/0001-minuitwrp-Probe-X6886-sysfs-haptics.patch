 #ifdef USE_INPUT_FF_HAPTICS
 #include <chrono>
 #include <condition_variable>
@@ -70,6 +72,9 @@ static std::atomic_int vib_on_count = 0;
 
 #define LEDS_HAPTICS_DURATION_FILE	"/sys/class/leds/vibrator/duration"
 #define LEDS_HAPTICS_ACTIVATE_FILE	"/sys/class/leds/vibrator/activate"
+#define LEDS_HAPTICS_SINGLE_DURATION_FILE	"/sys/class/leds/vibrator_single/duration"
+#define LEDS_HAPTICS_SINGLE_ACTIVATE_FILE	"/sys/class/leds/vibrator_single/activate"
+#define LEDS_HAPTICS_BRIGHTNESS_FILE	"/sys/class/leds/vibrator/brightness"
 
 #ifndef SYN_REPORT
 #define SYN_REPORT          0x00
@@ -182,6 +187,10 @@ class InputForceFeedbackHaptics {
         return *instance;
     }
 
+    bool Available() {
+        return OpenDevice();
+    }
+
     void Pulse(int duration_ms) {
         {
             std::lock_guard<std::mutex> lock(mutex_);
@@ -359,6 +368,43 @@ class InputForceFeedbackHaptics {
 }  // namespace
 #endif
 
+static bool vibrate_sysfs(int timeout_ms, const char* tout) {
+    if (access(LEDS_HAPTICS_SINGLE_ACTIVATE_FILE, W_OK) == 0) {
+        write_to_file(LEDS_HAPTICS_SINGLE_DURATION_FILE, tout);
+        write_to_file(LEDS_HAPTICS_SINGLE_ACTIVATE_FILE, "1");
+        return true;
+    }
+    if (access(LEDS_HAPTICS_ACTIVATE_FILE, W_OK) == 0) {
+        write_to_file(LEDS_HAPTICS_DURATION_FILE, tout);
+        write_to_file(LEDS_HAPTICS_ACTIVATE_FILE, "1");
+        return true;
+    }
+    if (access(VIBRATOR_TIMEOUT_FILE, W_OK) == 0) {
+        write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
+        return true;
+    }
+    if (access(LEDS_HAPTICS_BRIGHTNESS_FILE, W_OK) == 0) {
+        /* MTK regulator-vibrator exposes only brightness. Pulse it off the UI
+           thread; a newer request owns the final off transition. */
+        static std::mutex brightness_mutex;
+        static unsigned brightness_sequence = 0;
+        std::thread([timeout_ms] {
+            unsigned sequence;
+            {
+                std::lock_guard<std::mutex> lock(brightness_mutex);
+                sequence = ++brightness_sequence;
+            }
+            write_to_file(LEDS_HAPTICS_BRIGHTNESS_FILE, "255");
+            usleep(timeout_ms * 1000);
+            std::lock_guard<std::mutex> lock(brightness_mutex);
+            if (sequence == brightness_sequence)
+                write_to_file(LEDS_HAPTICS_BRIGHTNESS_FILE, "0");
+        }).detach();
+        return true;
+    }
+    return false;
+}
+
 int vibrate(int timeout_ms)
 {
     if (timeout_ms > 10000) timeout_ms = 1000;
@@ -366,6 +412,8 @@ int vibrate(int timeout_ms)
     char tout[6];
     sprintf(tout, "%i", timeout_ms);
 
+    if (vibrate_sysfs(timeout_ms, tout)) return 0;
+
 #ifdef USE_INPUT_FF_HAPTICS
     InputForceFeedbackHaptics::Instance().Pulse(timeout_ms);
 #elif defined(USE_QTI_HAPTICS)
@@ -414,6 +462,28 @@ int vibrate(int timeout_ms)
 #endif
 #endif
 
+int haptics_available()
+{
+#if defined(TW_NO_HAPTICS)
+    return 0;
+#elif defined(TW_HAPTICS_TSPDRV)
+    return 1;
+#else
+    if (access(LEDS_HAPTICS_SINGLE_ACTIVATE_FILE, W_OK) == 0 ||
+        access(LEDS_HAPTICS_ACTIVATE_FILE, W_OK) == 0 ||
+        access(VIBRATOR_TIMEOUT_FILE, W_OK) == 0 ||
+        access(LEDS_HAPTICS_BRIGHTNESS_FILE, W_OK) == 0)
+        return 1;
+#ifdef USE_INPUT_FF_HAPTICS
+    return InputForceFeedbackHaptics::Instance().Available() ? 1 : 0;
+#elif defined(USE_QTI_HAPTICS) || defined(USE_QTI_AIDL_HAPTICS) || defined(USE_SAMSUNG_HAPTICS)
+    return 1;
+#else
+    return 0;
+#endif
+#endif
+}
