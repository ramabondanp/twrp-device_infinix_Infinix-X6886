From: Arena Agent <agent@arena.ai>
Date: Thu, 6 Nov 2026 00:00:00 +0000
Subject: [PATCH 4/4] AERA: respect disabled recovery repacking

X6886 boots a zstd PLATFORM ramdisk plus an empty RECOVERY fragment in
vendor_boot. The bundled repacker expects recovery.cpio and must not be
advertised or reachable.

AERA force-enabled TW_INCLUDE_REPACKTOOLS for vendor_boot/recovery-as-boot
even when TW_NO_FLASH_CURRENT_TWRP was set. Guard those assignments and
magiskboot inclusion, and reject runtime repack/reflash entry points when
current-recovery flashing is disabled.

diff --git a/Android.mk b/Android.mk
index 488f1e4..741910c 100644
--- a/Android.mk
+++ b/Android.mk
@@ -229,7 +229,9 @@ ifneq ($(BOARD_BOOT_HEADER_VERSION),)
 endif
 
 ifeq ($(BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT),true)
-    TW_INCLUDE_REPACKTOOLS := true
+    ifneq ($(TW_NO_FLASH_CURRENT_TWRP),true)
+        TW_INCLUDE_REPACKTOOLS := true
+    endif
     LOCAL_CFLAGS += -DBOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT
 endif
 
@@ -242,6 +244,7 @@ ifeq ($(TW_NO_BIND_SYSTEM),true)
 endif
 
 ifeq ($(TW_NO_FLASH_CURRENT_TWRP),true)
+    TW_INCLUDE_REPACKTOOLS := false
     LOCAL_CFLAGS += -DTW_NO_FLASH_CURRENT_TWRP
 endif
 
@@ -278,7 +281,9 @@ ifeq ($(TW_EXCLUDE_MTP),)
     LOCAL_SHARED_LIBRARIES += libtwrpmtp-ffs
 endif
 ifeq ($(BOARD_USES_RECOVERY_AS_BOOT), true)
-    TW_INCLUDE_REPACKTOOLS := true
+    ifneq ($(TW_NO_FLASH_CURRENT_TWRP),true)
+        TW_INCLUDE_REPACKTOOLS := true
+    endif
     LOCAL_CFLAGS += -DBOARD_USES_RECOVERY_AS_BOOT
 endif
 
@@ -636,9 +641,11 @@ ifneq ($(TW_EXCLUDE_BASH), true)
 endif
 
 ifeq ($(TW_INCLUDE_REPACKTOOLS), true)
+ifneq ($(TW_NO_FLASH_CURRENT_TWRP),true)
 TWRP_REQUIRED_MODULES += \
     magiskboot
 endif
+endif
 
 ifeq ($(TW_INCLUDE_RESETPROP), true)
 TWRP_REQUIRED_MODULES += \
